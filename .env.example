# InvoicePro – Environment Variables
# Copy this file to .env and fill in your values.

# ── Core ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# SQLite (default) – swap for PostgreSQL in production:
# DATABASE_URL=postgresql://user:pass@localhost/invoicepro
DATABASE_URL=

# ── Email (SMTP) ──────────────────────────────────────
# Leave blank to disable email sending (UI still shows the form).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tsadnan407@gmail.com
MAIL_PASSWORD=adnants.in
MAIL_DEFAULT_SENDER=tsadnan407@gmail.com

# ── File Uploads ──────────────────────────────────────
# Maximum upload size in bytes (default 5 MB)
MAX_CONTENT_LENGTH=5242880
